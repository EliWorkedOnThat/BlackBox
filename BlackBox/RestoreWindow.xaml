<Window x:Class="BlackBox.RestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Snapshot"
        Background="{StaticResource BgBrush}"
        Height="700"
        Width="700"
        MinHeight="500"
        MinWidth="500"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="40,30,40,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,24">
            <TextBlock Text="Select Snapshot"
                       FontFamily="Segoe UI"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Pick a snapshot to bring back"
                       FontFamily="Segoe UI"
                       FontSize="14"
                       Foreground="{StaticResource MutedTextBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                MaxWidth="560"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="8">
            <ListBox x:Name="SnapshotList"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource SnapshotItem}"/>
        </Border>

        <Button Grid.Row="2"
                Content="Resurrect"
                Style="{StaticResource AccentButton}"
                Width="240"
                Height="54"
                FontSize="18"
                HorizontalAlignment="Center"
                Margin="0,24,0,0"
                Click="RestoreBytes"/>
    </Grid>
</Window>