<Window x:Class="BlackBox.RestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Snapshot"
        Background="#242526"
        Height="700"
        Width="700">

    <Grid>

        <TextBlock
            Text="Select Snapshot"
            FontSize="28"
            FontWeight="Bold"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,25,0,0"/>

        <ListBox
            x:Name="SnapshotList"
            Width="550"
            Height="400"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,90,0,0"/>

        <Button
            Content="Resurrect"
            Width="250"
            Height="70"
            FontSize="22"
            Foreground="Cyan"
            Background="Black"
            BorderBrush="Cyan"
            BorderThickness="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,530,0,0"
            Click="RestoreBytes"/>
            </Grid>

</Window>