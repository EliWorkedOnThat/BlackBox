<Window x:Class="BlackBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BlackBox"
        mc:Ignorable="d"
        Title="BlackBox"
        Background="#E0B0FF"
        Height="800"
        Width="900">

    <Grid>

        <TextBlock
            Text="BlackBox"
            FontSize="32"
            FontWeight="Bold"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,30,0,0"/>

        <ScrollViewer
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,250,0,0"
            Width="650"
            Height="350"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Auto">

            <TextBox
            IsReadOnly="True"
            TextWrapping="Wrap"
            AcceptsReturn="True"
            Background="White"
            BorderBrush="Black"
            BorderThickness="2"
            Padding="10"/>

        </ScrollViewer>

        <StackPanel
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,150,0,0">

            <Button
                Content="Save Snapshot"
                Width="250"
                Height="60"
                FontSize="18"
                Margin="0,0,15,0"/>

            <Button
                Content="Resurrect Snapshot"
                Width="250"
                Height="60"
                FontSize="18"/>

        </StackPanel>

    </Grid>

</Window>